{{/*
Helpers for nats-auth-callout-service. Chart-name/fullname/labels follow the standard
Helm chart-template conventions (as generated by `helm create`); the rest collect the
distinct k8sSecret names referenced across values.secrets (P03 mount contract, P17).
*/}}

{{- define "nats-auth-callout-service.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{- define "nats-auth-callout-service.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{- define "nats-auth-callout-service.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{- define "nats-auth-callout-service.labels" -}}
helm.sh/chart: {{ include "nats-auth-callout-service.chart" . }}
{{ include "nats-auth-callout-service.selectorLabels" . }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- end -}}

{{- define "nats-auth-callout-service.selectorLabels" -}}
app.kubernetes.io/name: {{ include "nats-auth-callout-service.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{- define "nats-auth-callout-service.serviceAccountName" -}}
{{- if .Values.serviceAccount.create -}}
{{- default (include "nats-auth-callout-service.fullname" .) .Values.serviceAccount.name -}}
{{- else -}}
{{- default "default" .Values.serviceAccount.name -}}
{{- end -}}
{{- end -}}

{{- define "nats-auth-callout-service.image" -}}
{{- $tag := .Values.image.tag | default .Chart.AppVersion -}}
{{- printf "%s:%s" .Values.image.repository $tag -}}
{{- end -}}

{{/*
Every distinct existingSecret name referenced by values.secrets, in the k8sSecret mount
contract (src/AuthCallout.Secrets/README.md, consumed by P17): one Pod volume per distinct
Secret name, mounted at /var/run/secrets/{name}. Returns a de-duplicated, sorted list of
secret names (empty entries dropped) so callers can range over it once for volumes and
once for volumeMounts without repeating the collection logic.
*/}}
{{- define "nats-auth-callout-service.k8sSecretNames" -}}
{{- $names := list -}}
{{- if .Values.secrets.issuerSeed.existingSecret -}}
{{- $names = append $names .Values.secrets.issuerSeed.existingSecret -}}
{{- end -}}
{{- if and .Values.secrets.serviceUserSeed.enabled .Values.secrets.serviceUserSeed.existingSecret -}}
{{- $names = append $names .Values.secrets.serviceUserSeed.existingSecret -}}
{{- end -}}
{{- if and .Values.secrets.xkey.enabled .Values.secrets.xkey.existingSecret -}}
{{- $names = append $names .Values.secrets.xkey.existingSecret -}}
{{- end -}}
{{- range .Values.secrets.assertionKeys -}}
{{- if .existingSecret -}}
{{- $names = append $names .existingSecret -}}
{{- end -}}
{{- end -}}
{{- if and (eq .Values.source.kind "postgres") .Values.source.postgres.connectionString.existingSecret -}}
{{- $names = append $names .Values.source.postgres.connectionString.existingSecret -}}
{{- end -}}
{{- $names | uniq | sortAlpha | toJson -}}
{{- end -}}

{{/*
Sanitizes a Kubernetes Secret name into a safe volume name (RFC 1123 label, prefixed to
avoid collisions with other volume names in the Deployment template).
*/}}
{{- define "nats-auth-callout-service.secretVolumeName" -}}
{{- printf "secret-%s" . | trunc 63 | trimSuffix "-" -}}
{{- end -}}
