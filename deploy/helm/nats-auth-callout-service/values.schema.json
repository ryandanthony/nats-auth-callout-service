{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "nats-auth-callout-service",
  "type": "object",
  "properties": {
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["files", "k8s", "postgres"]
        }
      },
      "required": ["kind"]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "health": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        }
      }
    }
  }
}
