<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <!-- P15 AppHost.Local (doc 08 §Local development, "AppHost 1 - AppHost.Local (files source,
       external NATS)"): the day-to-day inner loop. Files-source callout, NATS w/ JetStream on
       an external port so the `nats` CLI and scratch clients can also connect, a Keycloak dev
       IdP importing config/../realm/dev-realm.json, and both sample apps.

       Aspire.AppHost.Sdk's version here is independent of Directory.Packages.props (an MSBuild
       Sdk import, not a NuGet PackageReference) but is pinned to match the
       Aspire.Hosting.AppHost PackageVersion the coordinator added, so the two never drift. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>7f4c1c1e-9c9c-4b3a-9c0f-b9c1f8a6c7f1</UserSecretsId>
    <!-- MA0048 (file name must match type name) does not apply to Aspire's top-level-
         statement AppHost.cs, which declares no type. CA1017 fires because Aspire's
         source-generated Projects.* types are externally visible; this AppHost is never
         COM-consumed, so ComVisible(false) would be a no-op ceremony, not a real fix. -->
    <NoWarn>$(NoWarn);MA0048;CA1017</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Nats" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
  </ItemGroup>

  <ItemGroup>
    <!-- AuthCallout.Host is not registered in AuthCallout.slnx (coordinator's call: "keep
         dev/ AppHosts OUT of AuthCallout.slnx" so CI's sln build/coverage gate stays clean of
         Aspire + the prerelease Keycloak package). Aspire's Projects.* source generator reads
         ProjectReference items on the AppHost project itself, not the solution, so
         Projects.AuthCallout_Host / Projects.NoteService / Projects.TaskService are still
         generated normally from the references below. -->
    <ProjectReference Include="../../src/AuthCallout.Host/AuthCallout.Host.csproj" />
    <ProjectReference Include="../samples/NoteService/NoteService.csproj" />
    <ProjectReference Include="../samples/TaskService/TaskService.csproj" />
  </ItemGroup>

</Project>
