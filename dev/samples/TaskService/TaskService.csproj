<Project Sdk="Microsoft.NET.Sdk">

  <!-- P20 sample app (dev/ only): the "tasks" application modeled as a Wolverine app over
       NATS, authenticated through the callout via AuthCallout.Client.Wolverine - a second,
       independent application from NoteService (own account/issuer match/subject space)
       proving isolation (ADR 0001). Domain (commands/queries/events) with an in-memory store,
       plus an in-process demo client. Identity propagation is handled entirely by the package.
       Not referenced by src/ or tests/; both AppHosts add it as Projects.TaskService. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/SampleSupport.csproj" />
    <ProjectReference Include="../../../src/AuthCallout.Client.Wolverine/AuthCallout.Client.Wolverine.csproj" />
  </ItemGroup>

</Project>
