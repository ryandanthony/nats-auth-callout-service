<Project Sdk="Microsoft.NET.Sdk">

  <!-- P20 sample app (dev/ only): the "notes" application modeled as a Wolverine app over
       NATS, authenticated through the callout via AuthCallout.Client.Wolverine. Domain
       (commands/queries/events) with an in-memory store and handlers, plus an in-process demo
       client that drives traffic. Identity propagation (outbound attach + inbound
       verification) is handled entirely by the package (UseNatsWithCallout +
       CalloutIdentityMiddleware/CalloutIdentityPolicy) - no sample-local plumbing left. Not
       referenced by src/ or tests/; both AppHosts add it as Projects.NoteService. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Wolverine discovers handlers on static classes and generates code that references
         the sample's own message types; its top-level Program.cs declares no type (MA0048),
         and Wolverine's generated handler code is exercised at runtime, not compile-time. -->
    <NoWarn>$(NoWarn);MA0048</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/SampleSupport.csproj" />
    <ProjectReference Include="../../../src/AuthCallout.Client.Wolverine/AuthCallout.Client.Wolverine.csproj" />
  </ItemGroup>

</Project>
