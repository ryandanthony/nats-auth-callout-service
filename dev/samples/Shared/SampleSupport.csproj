<Project Sdk="Microsoft.NET.Sdk">

  <!-- Small internal helper library shared by the two Wolverine sample apps (NoteService,
       TaskService) and LoadService, NOT a shipped src/ project and not referenced by anything
       outside dev/samples/. Post-P20: only the dev-only bits remain here (DevEnvironment,
       DevOidcTokenFetcher, OidcTokenClaims for LoadService's token-expiry check) — everything
       else (connection, discovery, identity propagation/verification) moved to
       AuthCallout.Client / AuthCallout.Client.Wolverine. Only ever built as part of the dev/
       tree; no ProjectReference from src/ or tests/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
