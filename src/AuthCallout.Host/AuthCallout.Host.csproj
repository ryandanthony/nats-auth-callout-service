<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UserSecretsId>dotnet-AuthCallout.Host-be8fee1a-a9d8-48b7-b683-2bf075b0b6e2</UserSecretsId>
  </PropertyGroup>

  <!-- Health endpoints are a minimal WebApplication on a dedicated port (doc 08 Health
       and readiness), not a Worker; the Worker SDK doesn't pull in ASP.NET Core's minimal-API
       / health-check-endpoint surface by default, so it's added explicitly here rather than
       switching the whole project to Microsoft.NET.Sdk.Web (which would also pull in MVC/
       Razor this service never needs, doc 08 Runtime and trimming: "not an ASP.NET MVC/Razor
       app"). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthCallout.Core\AuthCallout.Core.csproj" />
    <ProjectReference Include="..\AuthCallout.Contracts\AuthCallout.Contracts.csproj" />
    <ProjectReference Include="..\AuthCallout.Nats\AuthCallout.Nats.csproj" />
    <ProjectReference Include="..\AuthCallout.Identity\AuthCallout.Identity.csproj" />
    <ProjectReference Include="..\AuthCallout.Config.Files\AuthCallout.Config.Files.csproj" />
    <ProjectReference Include="..\AuthCallout.Config.K8s\AuthCallout.Config.K8s.csproj" />
    <ProjectReference Include="..\AuthCallout.Config.Postgres\AuthCallout.Config.Postgres.csproj" />
    <ProjectReference Include="..\AuthCallout.Secrets\AuthCallout.Secrets.csproj" />
  </ItemGroup>

</Project>
