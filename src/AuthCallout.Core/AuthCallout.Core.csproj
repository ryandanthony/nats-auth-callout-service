<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Decision core of nats-auth-callout-service: claims access, claim matching and grant templates. A dependency of AuthCallout.Identity, with no transport or storage dependencies.</Description>
  </PropertyGroup>

  <!-- Decision core: pipeline, selectors, matcher, minter. No transport, storage,
       or k8s package references (doc 08 reference-isolation invariant). -->

  <ItemGroup>
    <ProjectReference Include="..\AuthCallout.Contracts\AuthCallout.Contracts.csproj" />
  </ItemGroup>

  <!-- P05: the pipeline's internal stage helpers (AppSelector, ProfileSelector, GrantBuilder,
       AnonymousComposer, UnvalidatedIssuerReader) are internal — only ResolutionPipeline
       (the IResolutionPipeline implementation P07/P13 consume) is the public surface — so
       AuthCallout.Core.Tests needs direct access for table/unit testing each stage in
       isolation, matching this project's decision-layer-in-isolation testing goal (doc 08). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AuthCallout.Core.Tests" />
  </ItemGroup>

</Project>
